<resources>
    <!-- Header icon buttons, top right. Colours and the focused look are set in code per day/night theme. -->
    <style name="IconButton">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginStart">6dp</item>
    </style>
    <style name="TabText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">29dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
