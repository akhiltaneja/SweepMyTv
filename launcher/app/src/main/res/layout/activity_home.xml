<?xml version="1.0" encoding="utf-8"?>
<!-- Sweep TV. 960 × 540 dp. The page holds everything that scrolls: header, picks, dock, then All apps below the
     fold. Colours are applied in code for the day or night theme. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background: theme gradient, the current pick's image (or your wallpaper) and the scrim, as one layer. -->
    <com.sweepmytv.launcher.Backdrop android:id="@+id/backdrop" android:layout_width="match_parent"
        android:layout_height="match_parent" android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- A separate navigation row between the clock and the content shelf. -->
        <LinearLayout
            android:id="@+id/for_you_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="112dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="3dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/tab_recent" style="@style/TabText" android:text="Continue" />
                <TextView android:id="@+id/tab_trending" style="@style/TabText" android:text="Trending" />
                <TextView android:id="@+id/tab_india" style="@style/TabText" android:text="New in India" />
            </LinearLayout>

        </LinearLayout>

        <!-- Header, right: widgets and TV controls. -->
        <LinearLayout
            android:id="@+id/header_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="end"
            android:orientation="vertical">

            <!-- Not clipped: a focused icon grows past the row's edges -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/top_insights"
                    android:layout_width="196dp" android:layout_height="36dp"
                    android:layout_gravity="center_vertical" android:layout_marginEnd="6dp"
                    android:visibility="gone">
                    <com.sweepmytv.launcher.Meters android:id="@+id/meters"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:importantForAccessibility="yes" />
                </FrameLayout>
                <com.sweepmytv.launcher.MarketCard android:id="@+id/market_card"
                    android:layout_width="133dp" android:layout_height="36dp"
                    android:layout_gravity="center_vertical" android:layout_marginEnd="6dp"
                    android:importantForAccessibility="yes" android:visibility="gone" />
                <FrameLayout android:id="@+id/top_air"
                    android:layout_width="140dp" android:layout_height="36dp"
                    android:layout_gravity="center_vertical" android:layout_marginEnd="4dp"
                    android:visibility="gone" />
                <ImageView android:id="@+id/icon_cc" style="@style/IconButton" android:src="@drawable/ic_sweep_controls" android:importantForAccessibility="no" android:visibility="gone" />
                <ImageView android:id="@+id/icon_inputs" style="@style/IconButton" android:src="@drawable/ic_sweep_inputs" android:contentDescription="Inputs" />
                <ImageView android:id="@+id/icon_wifi" style="@style/IconButton" android:src="@drawable/ic_sweep_wifi" android:contentDescription="Wi-Fi" />
                <ImageView android:id="@+id/icon_settings" style="@style/IconButton" android:src="@drawable/ic_sweep_settings" android:contentDescription="Settings" />
                <!-- Shown only while the Play Store has updates waiting -->
                <ImageView android:id="@+id/icon_bell" style="@style/IconButton" android:src="@drawable/ic_bell" android:contentDescription="App updates" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Greeting, followed by the clock and a quiet date label. -->
        <LinearLayout
            android:id="@+id/big_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/big_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.015"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="top"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/big_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-2dp"
                    android:fontFamily="@font/outfit"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="36sp" />
                <TextView
                    android:id="@+id/big_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/big_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:fontFamily="@font/outfit"
                    android:letterSpacing="0.015"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Picks: the current one large, the rest small -->
        <com.sweepmytv.launcher.PicksRow
            android:id="@+id/picks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="159dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/pick_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="42dp"
            android:layout_marginTop="353dp"
            android:layout_marginEnd="40dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/pick_caption_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/outfit"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/pick_caption_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Dock: one band, 5 to 10 apps (Sweep TV settings → Dock size), then the All apps button -->
        <FrameLayout
            android:id="@+id/dock_band"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="414dp"
            android:layout_marginEnd="20dp"
            android:clipChildren="false">
            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:gravity="center"
                android:orientation="horizontal" />
        </FrameLayout>

        <!-- Below the fold: app channels (chosen in Control Center → Channels), then every other app.
             Their positions are set in code. -->
        <LinearLayout
            android:id="@+id/channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="548dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/all_apps_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="566dp"
            android:fontFamily="@font/outfit"
            android:text="All apps"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="606dp"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingBottom="80dp" />
    </FrameLayout>

    <!-- The focus ring, drawn over whatever is focused -->
    <com.sweepmytv.launcher.HighlightView
        android:id="@+id/ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <TextView
        android:id="@+id/move_hint"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/outfit"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/drawer_hint"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:fontFamily="@font/outfit"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/drawer_home_hint"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Inputs, Control Center and Channels menus; scrolls when long -->
    <ScrollView
        android:id="@+id/menu_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fadingEdge="none"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>
</FrameLayout>
